<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ludo_masters_game_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView android:id="@+id/brand_logo"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ludo_masters_splash"/>

    <ImageView android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/lm_shield_description"
        android:src="@drawable/lm_shield"/>

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="PLAY • COMPETE • MASTER"
        android:textColor="#FFE4AA"
        android:textSize="15sp"
        android:letterSpacing="0.08"/>
</LinearLayout>
