<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7FF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">
    <ImageView
        android:id="@+id/brand_logo"
        android:layout_width="208dp"
        android:layout_height="208dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/lhj_emblem_description"
        android:src="@drawable/lhj_emblem" />
    <TextView
        android:id="@+id/brand_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textSize="34sp"
        android:textColor="#172B54"
        android:gravity="center" />
    <TextView
        android:id="@+id/brand_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lhj_tagline"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#2586F5"
        android:gravity="center" />
    <LinearLayout
        android:id="@+id/brand_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:contentDescription="Loading">
        <View android:id="@+id/loader_red" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp" android:background="@drawable/lhj_loader_dot"
            android:backgroundTint="#F04452"/>
        <View android:id="@+id/loader_yellow" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp" android:background="@drawable/lhj_loader_dot"
            android:backgroundTint="#FFC342"/>
        <View android:id="@+id/loader_blue" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp" android:background="@drawable/lhj_loader_dot"
            android:backgroundTint="#2586F5"/>
        <View android:id="@+id/loader_green" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp" android:background="@drawable/lhj_loader_dot"
            android:backgroundTint="#23BF75"/>
    </LinearLayout>
</LinearLayout>